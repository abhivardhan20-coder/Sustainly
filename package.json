    "express-rate-limit": "^8.5.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "gsap": "^3.15.0",
    "helmet": "^8.2.0",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
